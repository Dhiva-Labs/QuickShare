#!/bin/sh
# postrm for nearshare.
#
# Best-effort re-index of the desktop-entry and icon-theme caches on
# removal/purge, mirroring debian/postinst. Never fails the removal if the
# tool is missing or errors out.

set -e

case "$1" in
    remove|purge)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications \
                >/dev/null 2>&1 || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor \
                >/dev/null 2>&1 || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        ;;
esac

#DEBHELPER#

exit 0
