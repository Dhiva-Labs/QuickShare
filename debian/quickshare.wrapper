#!/bin/sh
# NearShare launcher installed by the Debian package.
#
# Unlike bin/nearshare in the upstream source tree (which execs the
# project's dev .venv), the packaged app has no venv: it runs against the
# system python3 with the app tree installed under /usr/share/nearshare.
# Prepending that to PYTHONPATH makes `import nearshare` resolve to
# /usr/share/nearshare/nearshare -- and because it's an exported
# environment variable, every subprocess.Popen/os.execv call the app makes
# to relaunch itself (`nearshare gui`, `on`/`toggle` auto-starting the
# app, the Nautilus script/extension calling back into `nearshare
# send-picker`) inherits it too, so `python3 -m nearshare` keeps
# resolving no matter how deep the call chain goes.
export PYTHONPATH="/usr/share/nearshare${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m nearshare.cli "$@"
