#!/usr/bin/make -f

# NearShare is pure Python 3 -- there is no compile step. dh's build-system
# autodetection finds nothing to do here (no setup.py/pyproject.toml, no
# Makefile) and falls back to the "none" build system, which is exactly
# what we want: every real step below is an override.
#
# We deliberately do NOT install via dh-python/pybuild into dist-packages:
# upstream ships no setup.py or pyproject.toml (see packaging/DEB.md for
# why one wasn't added just for packaging), so instead the whole nearshare/
# package tree is installed under /usr/share/nearshare and a thin
# /usr/bin/nearshare wrapper (debian/nearshare.wrapper) runs it with
# PYTHONPATH pointed there -- the same "wrapper + versioned install dir"
# shape used by the BranchPilot .deb in this house.

%:
	dh $@

# The generated protobuf bindings (nearshare/proto/*_pb2.py) are gitignored
# upstream on purpose: they are tied to the exact protobuf runtime version
# that generated them (see the ValidateProtobufRuntimeVersion() call in any
# generated module), so shipping ones generated against a developer's pip
# install of protobuf/grpcio-tools could mismatch noble's python3-protobuf.
# tools/genproto.sh regenerates them here, at build time, against whatever
# grpc_tools this build depends on (python3-grpc-tools) -- so the generated
# code always matches the protobuf runtime this same build will Depend on.
override_dh_auto_build:
	dh_auto_build
	# The protobuf bindings ship pre-generated in the source package,
	# built with the target distribution's own protoc so they match the
	# python3-protobuf this package Depends on. Only regenerate when
	# they are genuinely absent (e.g. building straight from a git
	# checkout, where they are gitignored); a buildd never takes this
	# branch, which is deliberate -- grpc_tools is not reliably
	# importable there.
	if [ ! -f nearshare/proto/offline_wire_formats_pb2.py ]; then \
		python3 -c 'import grpc_tools.protoc' || { \
			echo 'error: protobuf bindings are missing and' >&2; \
			echo '       grpc_tools.protoc is not importable.' >&2; \
			echo '       Run: sudo apt install python3-grpc-tools' >&2; \
			exit 1; \
		}; \
			bash tools/genproto.sh python3; \
	fi

override_dh_auto_test:
	# tests/test_loopback.py and tests/test_cli.py drive a real
	# NearShareService over 127.0.0.1 sockets (and, transitively,
	# BLE/D-Bus via nearshare.core.ble) -- not guaranteed to work inside
	# a network-isolated/unprivileged build chroot, and no different from
	# the upstream test suite one runs by hand with the dev .venv (see
	# each test file's own "Run:" docstring line). Skipped at package
	# build time; run manually before cutting a release instead.

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/nearshare/usr/share/nearshare
	cp -a nearshare debian/nearshare/usr/share/nearshare/
	find debian/nearshare/usr/share/nearshare -name '__pycache__' \
		-prune -exec rm -rf {} +
	mkdir -p debian/nearshare/usr/bin
	install -m 0755 debian/nearshare.wrapper \
		debian/nearshare/usr/bin/nearshare
	mkdir -p debian/nearshare/usr/share/applications
	install -m 0644 data/*.desktop \
		debian/nearshare/usr/share/applications/
	mkdir -p debian/nearshare/usr/share/icons/hicolor/scalable/apps
	install -m 0644 data/icons/dev.dhivalabs.nearshare.svg \
		debian/nearshare/usr/share/icons/hicolor/scalable/apps/
	# System-wide nautilus-python extension: makes the top-level
	# "Send with NearShare" right-click item work for every user with
	# no per-user `nearshare install` step. /usr/share/nautilus-python/
	# extensions is one of nautilus-python's built-in search paths
	# (confirmed via `dpkg -L python3-nautilus`, which ships that exact
	# directory, and /usr/share/doc/python3-nautilus/README.Debian,
	# which documents it as "all-user plugin directory" -- see
	# packaging/DEB.md). debian/extra/nearshare_menu.py is a hand-kept
	# copy of nearshare/cli.py's _NAUTILUS_EXTENSION_TEMPLATE with the
	# launcher path hardcoded to /usr/bin/nearshare instead of filled in
	# per-user.
	mkdir -p debian/nearshare/usr/share/nautilus-python/extensions
	install -m 0644 debian/extra/nearshare_menu.py \
		debian/nearshare/usr/share/nautilus-python/extensions/

override_dh_auto_clean:
	dh_auto_clean
	# NB: the generated *_pb2.py are NOT removed here. They ship in the
	# source package (see debian/source/options); deleting them on clean
	# would force a regeneration the buildd cannot perform.
	find . -name '__pycache__' -prune -exec rm -rf {} +
