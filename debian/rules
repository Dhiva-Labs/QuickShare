#!/usr/bin/make -f

# QuickShare is pure Python 3 -- there is no compile step. dh's build-system
# autodetection finds nothing to do here (no setup.py/pyproject.toml, no
# Makefile) and falls back to the "none" build system, which is exactly
# what we want: every real step below is an override.
#
# We deliberately do NOT install via dh-python/pybuild into dist-packages:
# upstream ships no setup.py or pyproject.toml (see packaging/DEB.md for
# why one wasn't added just for packaging), so instead the whole quickshare/
# package tree is installed under /usr/share/quickshare and a thin
# /usr/bin/quickshare wrapper (debian/quickshare.wrapper) runs it with
# PYTHONPATH pointed there -- the same "wrapper + versioned install dir"
# shape used by the BranchPilot .deb in this house.

%:
	dh $@

# The generated protobuf bindings (quickshare/proto/*_pb2.py) are gitignored
# upstream on purpose: they are tied to the exact protobuf runtime version
# that generated them (see the ValidateProtobufRuntimeVersion() call in any
# generated module), so shipping ones generated against a developer's pip
# install of protobuf/grpcio-tools could mismatch noble's python3-protobuf.
# tools/genproto.sh regenerates them here, at build time, against whatever
# grpc_tools this build depends on (python3-grpc-tools) -- so the generated
# code always matches the protobuf runtime this same build will Depend on.
override_dh_auto_build:
	dh_auto_build
	@python3 -c 'import grpc_tools.protoc' >/dev/null 2>&1 || { \
		echo 'error: grpc_tools.protoc is not importable by python3.' >&2; \
		echo '       Install the build dependency and retry:' >&2; \
		echo '           sudo apt install python3-grpc-tools' >&2; \
		exit 1; \
	}
	rm -f quickshare/proto/*_pb2.py
	tools/genproto.sh python3

override_dh_auto_test:
	# tests/test_loopback.py and tests/test_cli.py drive a real
	# QuickShareService over 127.0.0.1 sockets (and, transitively,
	# BLE/D-Bus via quickshare.core.ble) -- not guaranteed to work inside
	# a network-isolated/unprivileged build chroot, and no different from
	# the upstream test suite one runs by hand with the dev .venv (see
	# each test file's own "Run:" docstring line). Skipped at package
	# build time; run manually before cutting a release instead.

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/quickshare/usr/share/quickshare
	cp -a quickshare debian/quickshare/usr/share/quickshare/
	find debian/quickshare/usr/share/quickshare -name '__pycache__' \
		-prune -exec rm -rf {} +
	mkdir -p debian/quickshare/usr/bin
	install -m 0755 debian/quickshare.wrapper \
		debian/quickshare/usr/bin/quickshare
	mkdir -p debian/quickshare/usr/share/applications
	install -m 0644 data/*.desktop \
		debian/quickshare/usr/share/applications/
	mkdir -p debian/quickshare/usr/share/icons/hicolor/scalable/apps
	install -m 0644 data/icons/dev.dhivalabs.quickshare.svg \
		debian/quickshare/usr/share/icons/hicolor/scalable/apps/

override_dh_auto_clean:
	dh_auto_clean
	rm -f quickshare/proto/*_pb2.py
	find . -name '__pycache__' -prune -exec rm -rf {} +
